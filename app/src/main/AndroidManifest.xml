<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed because HelpActivity will optionally load http(s) pages,
         and the solve PoC's exfil listener is reached over cleartext HTTP
         on the loopback/lab network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Duckurity Help"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.WebViewCTF">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          VULNERABLE COMPONENT (intentional, for the CTF):
          - exported="true" so it can be reached by any other app or by
            `adb shell am start`, no permission required.
          - Declares a custom-scheme deep link (duckurity://help) so the
            "intended" flow is a link/notification tapped by the user,
            which is how this bug class usually reaches real users.
          - Accepts a raw "url" extra with NO allowlist/host check
            (see HelpActivity.kt) and loads it directly into a WebView
            that has a privileged @JavascriptInterface attached.
        -->
        <activity
            android:name=".HelpActivity"
            android:exported="true"
            android:label="Help Center">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="duckurity" android:host="help" />
            </intent-filter>
        </activity>

    </application>
</manifest>
